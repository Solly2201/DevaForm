// DevaForm persistence schema.
//
// Local development runs on SQLite (zero-setup). Production targets
// PostgreSQL — the schema deliberately avoids SQLite-only features so the
// switch is a provider + connection-string change plus a migration.
// Commerce tables (Product, Order, Material, PrintSpecification) arrive in
// Phase E; they are documented in docs/architecture.md, not stubbed here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// First-party identity. Guests work without an account: every visitor
// gets a Session; signing up claims the session's creations.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // scrypt hash, "salt:derivedKey" hex (see src/lib/auth.ts)
  passwordHash String
  createdAt    DateTime @default(now())

  sessions   Session[]
  characters Character[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  characters Character[]
}

model Character {
  id        String   @id @default(cuid())
  name      String
  deity     String
  // Ownership: a signed-in user, or the anonymous session that created it.
  // Rows with neither are legacy dev data (visible to everyone locally).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // Small JPEG data URL captured from the viewport on save; used as the
  // library thumbnail. Full configuration lives in CharacterVersion.
  preview   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CharacterVersion[]
  shares   Share[]

  @@index([userId])
  @@index([sessionId])
}

// A public share points at one immutable CharacterVersion, so the shared
// creation stays reproducible even after the original is edited.
model Share {
  id          String           @id @default(cuid())
  characterId String
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  versionId   String
  version     CharacterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
}

// Every save creates an immutable version — an order can pin a version and
// the exact statue remains reproducible even if the character is edited later.
model CharacterVersion {
  id            String   @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  schemaVersion Int
  // Full CharacterConfiguration JSON (validated before insert).
  config        String
  // Snapshot of { assetId: version } used by this configuration.
  assetVersions String
  createdAt     DateTime @default(now())

  shares Share[]

  @@index([characterId, createdAt])
}
